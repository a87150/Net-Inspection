# Copy to a protected service environment; do not commit the populated file.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dashboard.example.com

# Web and Worker must use the same production database.
DB_ENGINE=mysql
DB_NAME=net
DB_USER=net_app
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Windows can omit DB_PASSWORD and load the dedicated account from OS credentials.
# DB_PASSWORD_KEYRING_SERVICE=net-inspection-mariadb
# PC_LOG_SOURCE_ENCRYPTION_KEY_FILE=demo-runtime/.pc-log-source.key
# Web, Worker and manage.py load the root .env; explicit process variables win.
# NET_ENV_FILE can select a different environment file.
NET_REDIS_URL=redis://127.0.0.1:6379/1
NET_PAGE_CACHE_ENABLED=true
NET_PAGE_CACHE_SECONDS=15

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable and identical in both Web and Worker service environments.
DOMAIN_OPERATION_ENCRYPTION_KEY=replace-with-a-fernet-key
PC_LOG_SOURCE_ENCRYPTION_KEY=replace-with-a-fernet-key
# 原始配置备份的独立、稳定 Fernet 密钥；必须随数据库一同妥善备份。
DEVICE_BACKUP_ENCRYPTION_KEY=replace-with-a-fernet-key
# 也可使用 DEVICE_BACKUP_ENCRYPTION_KEY_FILE（相对项目根目录）。
# Windows 当前登录用户的凭据管理器：服务名下用户名固定为 device-backups。
# DEVICE_BACKUP_KEYRING_SERVICE=net-inspection-device-backups

# Optional reverse-proxy support for the Web application.
NET_TRUST_PROXY_HEADERS=false
