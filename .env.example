# Copy to a protected service environment; do not commit the populated file.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dashboard.example.com

# Web 与 Worker 必须指向同一个生产库。
# DB_ENGINE: mysql (MariaDB/MySQL) 或 postgresql。demo 也跟随这个值。
DB_ENGINE=mysql
DB_NAME=net
DB_USER=net_app
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# PostgreSQL：保留同样的键，端口改 5432。建库时用 LC_COLLATE 'C'，
# 让中文按字节序排序，与 utf8mb4_bin 一致。
# DB_ENGINE=postgresql
# DB_NAME=net
# DB_USER=postgres
# DB_PASSWORD=replace-with-a-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# deploy.demo 用的独立演示库。它绝不能等于 DB_NAME。
DB_DEMO_NAME=net-test
# 测试库名。留空则由 Django 推导出 test_<DB_NAME>；显式指定时不能与
# DB_NAME 或 DB_DEMO_NAME 重名——Django 会 DROP 重建测试库，撞名等于删数据。
# DB_TEST_NAME=

# SQLite 后端（演示/单机）才需要。DJANGO_SQLITE_PATH 留空则用项目内默认位置。
# NET_SQLITE_TIMEOUT=20
# NET_SQLITE_WAL_ENABLED=true

# collectstatic 的输出目录；不设则用 STATIC_ROOT 默认值。
# DJANGO_SQLITE_PATH=/var/lib/network-inspection/demo.sqlite3
# DJANGO_STATIC_ROOT=/var/lib/network-inspection/staticfiles

# Windows 可以省略 DB_PASSWORD，改从系统凭据管理器读取专用账号。
# DB_PASSWORD_KEYRING_SERVICE=net-inspection-mariadb
# PC_LOG_SOURCE_ENCRYPTION_KEY_FILE=demo-runtime/.pc-log-source.key
# Web、Worker 和 manage.py 都加载根目录 .env；显式进程变量优先。
# NET_ENV_FILE 可以换一个环境文件。
# NET_ENV_FILE=.env

NET_REDIS_URL=redis://127.0.0.1:6379/1
NET_PAGE_CACHE_ENABLED=true
NET_PAGE_CACHE_SECONDS=15
# 单个 Worker 进程同时打开的设备命令行（SSH/Telnet）会话上限。巡检配置里的
# concurrent_workers 只管一个任务，多个任务并行时仍可能占满交换机 VTY。
NET_SSH_CONCURRENCY=10

# 登录失败限速：账号 5 次、单个来源 20 次，窗口与锁定时长都是 900 秒。
# 填 0 关闭对应限制。/login/ 和 /admin/login/ 共用这一组计数。
# NET_LOGIN_MAX_FAILURES=5
# NET_LOGIN_IP_MAX_FAILURES=20
# NET_LOGIN_WINDOW_SECONDS=900
# NET_LOGIN_LOCK_SECONDS=900

# 会话有效期（秒），默认 1209600（两周）。
# NET_SESSION_COOKIE_AGE=1209600

# 日志级别：DEBUG / INFO / WARNING / ERROR。
# NET_LOG_LEVEL=INFO

# Windows 采集器的最低系统版本门槛。
# MIN_WINDOWS_RELEASE=10

# 生成一次：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 保持稳定，且 Web 与 Worker 两个服务的环境里必须完全一致。
DOMAIN_OPERATION_ENCRYPTION_KEY=replace-with-a-fernet-key
PC_LOG_SOURCE_ENCRYPTION_KEY=replace-with-a-fernet-key
# 原始配置备份的独立、稳定 Fernet 密钥；必须随数据库一同妥善备份。
DEVICE_BACKUP_ENCRYPTION_KEY=replace-with-a-fernet-key
# 也可使用 DEVICE_BACKUP_ENCRYPTION_KEY_FILE（相对项目根目录）。
# Windows 当前登录用户的凭据管理器：服务名下用户名固定为 device-backups。
# DEVICE_BACKUP_KEYRING_SERVICE=net-inspection-device-backups

# 反向代理后面的 Web 应用。四项都需要按实际部署开启，见管理文档的 HTTPS 一节。
NET_TRUST_PROXY_HEADERS=false
# NET_SECURE_COOKIES=false
# NET_SECURE_SSL_REDIRECT=false
# NET_SECURE_HSTS_SECONDS=0
# NET_SECURE_REFERRER_POLICY=same-origin
