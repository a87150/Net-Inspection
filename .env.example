# Copy to a protected service environment; do not commit the populated file.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dashboard.example.com

# Web and Worker must use the same production database.
DB_ENGINE=mysql
DB_NAME=net
DB_USER=net_app
DB_PASSWORD=replace-with-a-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable and identical in both Web and Worker service environments.
DOMAIN_OPERATION_ENCRYPTION_KEY=replace-with-a-fernet-key
PC_LOG_SOURCE_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional public URL for generated terminal scripts.
NET_PUBLIC_BASE_URL=https://dashboard.example.com
NET_TRUST_PROXY_HEADERS=false
