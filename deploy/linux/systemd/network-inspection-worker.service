[Unit]
Description=Network Inspection Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=net-inspection
Group=net-inspection
WorkingDirectory=/opt/net-inspection
EnvironmentFile=/etc/net-inspection/environment
ExecStart=/opt/net-inspection/.venv/bin/python manage.py run_task_worker --threads ${WORKER_THREADS} --poll-seconds ${WORKER_POLL_SECONDS} --lease-seconds ${WORKER_LEASE_SECONDS}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
StandardOutput=append:/var/log/net-inspection/worker.log
StandardError=append:/var/log/net-inspection/worker-error.log

[Install]
WantedBy=multi-user.target
