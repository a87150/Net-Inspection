# Shared by BOTH services and management commands. Replace all CHANGE_ME values.
DJANGO_SETTINGS_MODULE=net.settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,inspection.example.invalid
DJANGO_STATIC_ROOT=/var/lib/net-inspection/staticfiles
DB_ENGINE=mysql
DB_NAME=net_inspection
DB_USER=net_inspection
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
WEB_LISTEN=127.0.0.1:8000
WEB_THREADS=4
WORKER_THREADS=4
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=60
PYTHONUNBUFFERED=1
PYTHONUTF8=1
