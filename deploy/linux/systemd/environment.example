# Legacy manual-deployment reference. The one-click installer (install.sh) generates these
# values for you via `deploy.setup configure`; prefer it over editing by hand.
#
# DJANGO_SECRET_KEY must be 32+ characters and must NOT contain: change-me, change_me,
# replace-with, django-insecure, demo-only. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SETTINGS_MODULE=net.settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,inspection.example.invalid
DJANGO_STATIC_ROOT=/var/lib/net-inspection/staticfiles
DB_ENGINE=mysql
DB_NAME=net_inspection
DB_USER=net_inspection
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
WEB_LISTEN=127.0.0.1:8000
WEB_THREADS=4
WORKER_THREADS=4
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=60
PYTHONUNBUFFERED=1
PYTHONUTF8=1

# Three independent Fernet keys (32 random bytes, base64url, 44 chars). All three are required
# even before you import data. Generate each with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER regenerate these for an existing database: encrypted rows become unreadable.
DOMAIN_OPERATION_ENCRYPTION_KEY=CHANGE_ME_44_CHAR_FERNET_KEY_1_
PC_LOG_SOURCE_ENCRYPTION_KEY=CHANGE_ME_44_CHAR_FERNET_KEY_2_
DEVICE_BACKUP_ENCRYPTION_KEY=CHANGE_ME_44_CHAR_FERNET_KEY_3_
